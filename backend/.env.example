# Configuração do banco de dados.
# Local (padrão): SQLite num arquivo na pasta backend.
DATABASE_URL=sqlite:///./rota.db

# Para subir na nuvem (Supabase), troque por algo como (use o "Transaction
# pooler" IPv4, não a conexão direta — só IPv6, não funciona no Render):
# DATABASE_URL=postgresql+psycopg://usuario:senha@aws-1-sa-east-1.pooler.supabase.com:5432/postgres

# Segredo que assina o login. Em produção (Render), gere um valor aleatório
# único e nunca reaproveite o padrão do código.
AUTH_SECRET=troque-este-segredo-em-producao-ppg-rota

# Quantos dias o login fica válido no celular sem precisar entrar de novo.
TOKEN_DIAS=60

# URL do frontend em produção — liberada no CORS além de localhost:5175.
CORS_ORIGEM_EXTRA=https://ppg-rota-comercial.onrender.com
